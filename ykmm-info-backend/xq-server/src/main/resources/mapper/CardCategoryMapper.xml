<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xq.mapper.CardCategoryMapper">

  <select id="listAll" resultType="com.xq.entity.CardCategory">
    SELECT id, name, sort
    FROM card_category
    ORDER BY sort, id
  </select>

</mapper>