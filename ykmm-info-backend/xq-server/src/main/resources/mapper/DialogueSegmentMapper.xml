<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xq.mapper.DialogueSegmentMapper">

  <select id="listByLineIds" resultType="com.xq.entity.DialogueSegment">
    SELECT *
    FROM dialogue_segment
    WHERE line_id IN
    <foreach collection="lineIds" item="id" open="(" separator="," close=")">
      #{id}
    </foreach>
    ORDER BY sort, id
  </select>

</mapper>