<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xq.mapper.StoryCategoryTypeMapper">

  <sql id="baseColumns">
    id,
    name,
    description,
    color,
    sort,
    created_at     AS createdAt,
    updated_at     AS updatedAt
  </sql>

  <select id="listAll" resultType="com.xq.entity.StoryCategoryType">
    SELECT
    <include refid="baseColumns"/>
    FROM story_category_type
    ORDER BY sort, id
  </select>

  <select id="getById" resultType="com.xq.entity.StoryCategoryType">
    SELECT
    <include refid="baseColumns"/>
    FROM story_category_type
    WHERE id = #{id}
  </select>

  <update id="update">
    UPDATE story_category_type
    <set>
      <if test="name != null">name = #{name},</if>
      <if test="description != null">description = #{description},</if>
      <if test="color != null">color = #{color},</if>
      <if test="sort != null">sort = #{sort},</if>
    </set>
    WHERE id = #{id}
  </update>

</mapper>